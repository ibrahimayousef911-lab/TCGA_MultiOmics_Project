library(MOFA2)
library(data.table)

# Read the matched data
rna <- fread("01_Data/rna_matched.csv")
methyl <- fread("01_Data/methyl_matched.csv")

# Check dimensions
dim(rna)
dim(methyl)

# Convert to data.frame and set rownames
rna_df <- as.data.frame(rna)
rownames(rna_df) <- rna_df[,1]
rna_df <- rna_df[,-1]

methyl_df <- as.data.frame(methyl)
rownames(methyl_df) <- methyl_df[,1]
methyl_df <- methyl_df[,-1]

# Transpose to features x samples (MOFA2 expects this)
rna_t <- t(rna_df)
methyl_t <- t(methyl_df)

# Check
dim(rna_t)
dim(methyl_t)

library(MOFA2)

# Create MOFA object
MOFAobject <- create_mofa(list(
  "RNA" = as.matrix(rna_t),
  "Methylation" = as.matrix(methyl_t)
))

print(MOFAobject)

# Get default options
data_opts <- get_default_data_options(MOFAobject)
model_opts <- get_default_model_options(MOFAobject)
train_opts <- get_default_training_options(MOFAobject)

# Modify options
data_opts$scale_views <- TRUE
model_opts$likelihoods <- c("gaussian", "gaussian")
model_opts$spikeslab_weights <- TRUE
train_opts$convergence_mode <- "fast"
train_opts$seed <- 123

# Prepare MOFA object
MOFAobject <- prepare_mofa(
  MOFAobject,
  data_options = data_opts,
  model_options = model_opts,
  training_options = train_opts
)

print(MOFAobject)






