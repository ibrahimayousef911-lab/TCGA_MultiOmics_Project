# Reload the clinical data (to start fresh)
clinical <- read.csv("01_Data/BRCA_Clinical.txt", sep="\t", row.names = 1, check.names = FALSE)

# Subset to common samples
clinical_subset <- clinical[common_samples, ]

# Create time column: use Days_to_Death if deceased, else Days_to_Last_Contact
clinical_subset$Time <- ifelse(
  clinical_subset$Vital_Status_nature2012 == "DECEASED",
  clinical_subset$Days_to_date_of_Death_nature2012,
  clinical_subset$Days_to_Date_of_Last_Contact_nature2012
)

# Create status column: 1 if deceased, 0 if living
clinical_subset$Status <- ifelse(
  clinical_subset$Vital_Status_nature2012 == "DECEASED", 1, 0
)

# Remove rows with NA in Time
clinical_surv <- clinical_subset[!is.na(clinical_subset$Time), ]

# Check
table(clinical_surv$Status)


dim(clinical_surv)

library(survival)
library(survminer)

# Add clusters to survival data
clinical_surv$Cluster <- factors_clusters$Cluster[match(rownames(clinical_surv), rownames(factors_clusters))]

# Check
table(clinical_surv$Cluster)

# Create survival object
surv_object <- Surv(time = clinical_surv$Time, event = clinical_surv$Status)

# Fit Kaplan-Meier
km_fit <- survfit(surv_object ~ Cluster, data = clinical_surv)

# Plot
ggsurvplot(
  km_fit,
  data = clinical_surv,
  pval = TRUE,
  risk.table = TRUE,
  title = "Kaplan-Meier Survival Curves by MOFA2 Cluster"
)

